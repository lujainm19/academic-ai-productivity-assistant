# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real tokens/keys.

# Port the backend listens on. The Vite frontend proxies /api requests here.
PORT=8787

# Origin the frontend is served from — required for the session cookie to
# work cross-origin (frontend and backend are different ports in dev).
FRONTEND_ORIGIN=http://localhost:5173

# ── App accounts ─────────────────────────────────────────────────────────
# Required. Signs/verifies session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Required for Spotify/Calendar. Encrypts OAuth tokens at rest in the
# database. Generate one the same way as above (a different value):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Canvas LMS ── Account → Settings → Approved Integrations → New Access Token
# Base URL is your school's Canvas domain, no trailing slash.
CANVAS_BASE_URL=https://yourschool.instructure.com
CANVAS_API_TOKEN=

# Gemini ── https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
# Override if you want a different Gemini model; this is a sane default.
GEMINI_MODEL=gemini-2.5-flash

# Spotify ── https://developer.spotify.com/dashboard → Create app
# Redirect URI must be added in the app's dashboard settings, exactly as below.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8787/api/integrations/spotify/callback

# Google Calendar ── https://console.cloud.google.com → APIs & Services →
# Credentials → Create OAuth client ID (type: Web application).
# Add the redirect URI below under "Authorized redirect URIs", and enable
# the Google Calendar API for the project under APIs & Services → Library.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/integrations/google/callback
